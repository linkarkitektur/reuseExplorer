*.rux
*.rux-wal
*.rux-shm

# Root-level npm lock (no root package.json; created accidentally by npm)
/package-lock.json

# Local benchmark reports (scripts/bench.sh)
bench-results/

# Fixtures, assets and doc images are committed on purpose even though the
# extension-based rules above (*.png, *.pcd, *.db, *.db3, *.e57, *.h5, *.onnx,
# *.pt, *.off, ...) blanket-ignore those formats everywhere else in the repo.
# These negations must stay below the patterns they re-include, and none of
# tests/fixtures/, assets/, or docs/**/images/ are excluded at the directory
# level above, so the re-inclusion takes effect (see `git check-ignore -v`).
!tests/fixtures/**
!assets/**
!docs/**/images/**
!tools/rux-mcp/docs/**
scratch/

# superpowers skill session artifacts (never committed)
.superpowers/

# design-studio screenshots: a per-phase review artefact, never committed
/shots/

# local dev service state (process-compose postgres/minio data from the
# pre-split services devshell; ruxd's service stack now lives in ReUse-X/ruxd)
.dev/

# Beads / Dolt files (added by bd init)
.dolt/
.beads-credential-key
.beads/proxieddb/
*.gate.lock*
